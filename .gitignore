# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment — never commit real credentials; .env.example is the tracked template
.env
.env.local
!.env.example

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Agent workspace (research notes and scratch state, not deliverables)
.claude/work/
.claude/agent-memory/

# Runtime artifacts
*.log
!eval/results/*.log

# eval/results/ IS tracked on purpose: the README cites these numbers, and the raw
# per-question output is the evidence for them. A reviewer should be able to check the
# claim rather than take it on trust.
