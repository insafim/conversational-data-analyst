# Copy to .env and fill in an API key:  cp .env.example .env
# .env is gitignored; this template is tracked.

# ---------------------------------------------------------------------------
# LLM provider (ADR-007)
#
# Provider is chosen by the PREFIX of the model string, so switching provider is
# a change here, not a change in code. Set the API key for whichever you choose.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Two tiers: a fast model for classify/summarize, a stronger one for SQL generation.
# Defaults verified current on 2026-08-04 — model IDs are retired regularly, so if you
# get an authentication or bad-request error, check these first.
MODEL_CHEAP=anthropic/claude-haiku-4-5
MODEL_STRONG=anthropic/claude-sonnet-5

# OpenAI equivalents:
# MODEL_CHEAP=openai/gpt-5-mini
# MODEL_STRONG=openai/gpt-5.4-mini

# ---------------------------------------------------------------------------
# Database
#
# Port defaults to 55432, not 5432, so the demo does not collide with a PostgreSQL
# you may already have running locally.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=ports

# Owner credentials. Used ONLY by db/seed.py to load data.
#
# POSTGRES_ADMIN_USER names the superuser the application authenticates AS; docker-compose
# creates that superuser from POSTGRES_USER, a different variable that this file does not
# set and that therefore defaults to postgres inside the container. The two happen to agree
# today. Change this one alone and seed.py authenticates as a role the container never made,
# so set POSTGRES_USER to the same value or leave both alone.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres

# Read-only role. This is what the agent connects as, and it holds SELECT and
# nothing else — the load-bearing security control (ADR-004).
#
# The password appears twice on purpose and the two must stay equal. The application
# reads POSTGRES_ANALYST_PASSWORD; docker-compose passes ANALYST_RO_PASSWORD into
# db/02_roles.sql when the container first initialises. Changing one alone produces a
# password authentication failure with nothing in the message to explain why.
#
# The ROLE NAME, by contrast, is not configurable here at all: db/02_roles.sql writes
# analyst_ro literally. See the note beside APP_STORE_USER below; the same rule covers both.
POSTGRES_ANALYST_USER=analyst_ro
POSTGRES_ANALYST_PASSWORD=analyst_ro_pw
ANALYST_RO_PASSWORD=analyst_ro_pw

# The conversation store's role (ADR-014). Saved chats and per-turn telemetry live in a
# SEPARATE DATABASE, ports_app, which app_rw owns and which the agent's role cannot
# connect to at all: db/03_app_store.sql revokes CONNECT from PUBLIC and grants it only to
# app_rw. That is why a user cannot ask the agent to read other people's conversations,
# and why the database the agent queries never comes to hold user-supplied text.
# tests/test_store_isolation.py proves the denial.
#
# Separate database rather than a table or a schema because that is the production shape:
# analytics data and application state differ in ownership, lifecycle, workload and
# retention. Moving to a separate server later is a change of host in this DSN.
#
# NOT the two-name arrangement used above: there is one name here. The application and
# docker-compose both read APP_STORE_PASSWORD, and compose threads that same value into
# db/03_app_store.sql on first initialisation, so this pair cannot drift the way the
# analyst password can. Do not go looking for a second variable; there is not one.
#
# APP_STORE_USER is NOT symmetric with the two below it. APP_STORE_PASSWORD and
# APP_STORE_DB are threaded into db/03_app_store.sql and take effect there; the ROLE NAME is
# written literally in that script, so on the bundled database the role is always app_rw and
# changing this line would leave the application connecting as a role nothing ever created.
#
# The same is true of POSTGRES_ANALYST_USER above, whose role db/02_roles.sql also writes
# literally. The rule across this whole file is: passwords and database names are
# parameterised into the init scripts, role names are not.
#
# These are still real settings on the other deployment path. Point the app at a Postgres you
# provisioned yourself, where nothing in db/ runs and a DBA made the roles, and these are the
# variables that name them. So: leave them alone with docker compose, set them when you bring
# your own database.
APP_STORE_USER=app_rw
APP_STORE_PASSWORD=app_rw_pw
APP_STORE_DB=ports_app

# ---------------------------------------------------------------------------
# Limits (ADR-004)
# ---------------------------------------------------------------------------
STATEMENT_TIMEOUT_MS=5000
ROW_CAP=500
LLM_TIMEOUT_S=45
MAX_SQL_RETRIES=1

# Caps the untrusted text forwarded to the provider. A question longer than this is
# rejected before any model call, so an oversized paste costs nothing.
MAX_QUESTION_CHARS=2000

# ---------------------------------------------------------------------------
# Conversation (ADR-011)
# ---------------------------------------------------------------------------
# How many prior exchanges the rewrite node may read when resolving a follow-up.
# It sees prior questions and prior SQL only, never answer text or result rows.
HISTORY_TURNS=3

# ---------------------------------------------------------------------------
# Runtime verification (ADR-012)
# ---------------------------------------------------------------------------
# Off by default, and the default is measured rather than preferred. Runs 20 to 25
# alternated it on and off across the 108-case gold set: groundedness rose (98.7% to
# 100% against 96.0% to 97.4%) and execution accuracy fell by more (89.6% to 92.2%
# against 93.5% to 94.8%), at about 8% more latency and 31% more cost. Turn it on when
# an invented figure costs more than a wrong row. See ADR-012's addendum.
RUNTIME_VERIFICATION=false

# --- The plain-language reading beside each answer (ADR-013) ------------------
# On by default, and independent of the switch above. The verifier writes two things: a
# description of what the SQL measures, and an objection that can force a regeneration.
# Runs 20 to 25 measured the REGENERATION as the expensive half; the description costs
# one cheap-tier call and changes no SQL, no answer and no chart. With this on, every
# answered question carries a "What was measured" line; a refusal or a clarification has
# no SQL to describe and pays nothing. Measured at 18% to 27% more cost per answered
# question. Set to false, together with the switch above, to reproduce runs 20 to 25.
SQL_READING=true
